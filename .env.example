# ============================================================================
# Configurações Padronizadas de Banco de Dados
# Configuration Manager - Capivarios
# ============================================================================

# Seleção do motor ativo para a aplicação (postgresql | mysql | mariadb | oracle)
DB_DRIVER=postgresql

# Dados Comuns de Acesso aos Bancos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=config_manager
DB_USER=root
DB_PASSWORD=secret_password

# ============================================================================
# Portas dos Bancos de Dados no Docker Matrix (data-plane/docker-compose.yml)
# ============================================================================
POSTGRES_PORT=5432
MYSQL_PORT=3306
MARIADB_PORT=3307
ORACLE_PORT=1521
